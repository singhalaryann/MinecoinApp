{
    "objects": {
        "ui-theme": {
            "type": "ui",
            "keys": {
                "primary": {
                    "type": "string",
                    "description": "Primary blue color for main UI elements",
                    "default": "#3B82F6"
                },
                
                "accent": {
                    "type": "string",
                    "description": "Main emerald green accent color",
                    "default": "#10B981"
                },
               
                "background": {
                    "type": "string",
                    "description": "Main dark background color",
                    "default": "#0A0A0A"
                },
                "backgroundLight": {
                    "type": "string",
                    "description": "Lighter dark background for cards",
                    "default": "#111827"
                },
                "card": {
                    "type": "string",
                    "description": "Semi-transparent card background",
                    "default": "rgba(17, 24, 39, 0.95)"
                },
                "text": {
                    "type": "string",
                    "description": "Primary text color",
                    "default": "#F3F4F6"
                },
               
                "border": {
                    "type": "string",
                    "description": "Subtle border color",
                    "default": "rgba(59, 130, 246, 0.2)"
                },
               
                "shadow": {
                    "type": "string",
                    "description": "Primary shadow color",
                    "default": "#1E3A8A"
                },
                
                "fabShadow": {
                    "type": "string",
                    "description": "Shadow for floating action buttons",
                    "default": "#10B981"
                },
                "error": {
                    "type": "string",
                    "description": "Error/red color",
                    "default": "#EF4444"
                },
                
                "keysColor": {
                    "type": "string",
                    "description": "Orange color for keys section",
                    "default": "#F59E0B"
                },
                "companionColor": {
                    "type": "string",
                    "description": "Purple color for companions section",
                    "default": "#8B5CF6"
                },
                "lifestealColor": {
                    "type": "string",
                    "description": "Red color for lifesteal section",
                    "default": "#EF4444"
                },
                "pvpColor": {
                    "type": "string",
                    "description": "Orange color for PVP section",
                    "default": "#F59E0B"
                },
                "skyblockColor": {
                    "type": "string",
                    "description": "Purple color for skyblock section",
                    "default": "#8B5CF6"
                },
                "prisonColor": {
                    "type": "string",
                    "description": "Gray color for prison section",
                    "default": "#6B7280"
                },
                
                "white": {
                    "type": "string",
                    "description": "White color",
                    "default": "#FFFFFF"
                },
                
                "success": {
                    "type": "string",
                    "description": "Success color",
                    "default": "#10B981"
                },
                "warning": {
                    "type": "string",
                    "description": "Warning color",
                    "default": "#F59E0B"
                }
            }
        },
        "game-sections": {
        "type": "Level",
        "keys": {
          "sections": {
            "type": "array",
            "description": "Available game sections for filtering",
            "default": ["survival", "lifesteal", "creative", "pvp", "skyblock", "prison"]
          },
          "sectionConfigs": {
            "type": "text",
            "description": "Configuration for each game section with emojis and names",
            "default": "{\"survival\":{\"emoji\":\"🌲\",\"name\":\"Survival\"},\"lifesteal\":{\"emoji\":\"⚔\",\"name\":\"Lifesteal\"},\"creative\":{\"emoji\":\"🎨\",\"name\":\"Creative\"},\"pvp\":{\"emoji\":\"⚡\",\"name\":\"PvP\"},\"skyblock\":{\"emoji\":\"☁\",\"name\":\"Skyblock\"},\"prison\":{\"emoji\":\"🔒\",\"name\":\"Prison\"}}"
          },
          "defaultSection": {
            "type": "string",
            "description": "Default selected section when app loads",
            "default": "all"
          }
        }
      },
      "game-assets": {
        "type": "Level",
        "keys": {
          "content": {
            "type": "text",
            "description": "Game assets content structure - fetched from Firebase gamesAssets collection",
            "default": "{}"
          },
          "assetStructure": {
            "type": "text",
            "description": "Expected structure of game assets. 'tag' key is used for automatic category.",
            "default": "{\"id\":\"string\",\"title\":\"string\",\"section\":\"string\",\"price\":\"number\",\"originalPrice\":\"number\",\"discount\":\"number\",\"imageUrl\":\"string\",\"gameType\":\"string\",\"isNew\":\"boolean\",\"achievementText\":\"string\",\"tag\":\"string\"}"
          },
          "sections": {
            "type": "array",
            "description": "Available sections for game assets",
            "default": ["survival", "lifesteal", "creative", "pvp", "skyblock", "prison"]
          }
        }
      },
      "app-config": {
        "type": "Level",
        "keys": {
          "heroTitle": {
            "type": "string",
            "description": "Main hero title for the game assets screen",
            "default": "GAME ASSETS"
          },
          "heroSubtitle": {
            "type": "string",
            "description": "Hero subtitle template",
            "default": "Explore {count} premium assets"
          },
          "supportUrl": {
            "type": "string",
            "description": "Support Telegram URL",
            "default": "https://t.me/xgamingclub"
          },
          "supportButtonText": {
            "type": "string",
            "description": "Support button text",
            "default": "SUPPORT"
          }
        }
      }
    },
    "experiences": {
        "home": {
            "description": "Home screen",
            "objects": {
          "game-sections": true,
          "game-assets": true,
          "app-config": true
        }
        },
        "theme": {
            "description": "Global theme configuration",
            "objects": {
                "ui-theme": true
            }
        }
    }
}

